# ============================================
# .env - microservices-fargate (PRO)
# ============================================

# ---------- AWS ----------
export REGION="us-east-1"
export PROJECT="microservices-fargate"
export ENV_NAME="prod"

# ---------- NETWORK ----------
# false => con NAT (más simple)
# true  => sin NAT (requiere endpoints + reglas finas)
export MODE_NO_NAT="false"

# ---------- CONFIG SERVER (Git) ----------
export CONFIG_GIT_URI="https://github.com/Raulcudris/microservices-fargate-demo.git"
export CONFIG_GIT_BRANCH="deploy"
export CONFIG_GIT_PATHS="config-data"

# ---------- DATABASE (RDS) ----------
# Si ya tienes RDS creado, deja CREATE_RDS="false"
export CREATE_RDS="false"

# Endpoint actual de tu RDS
export DB_ENDPOINT="microservices-fargate-mysql.cub6aqum4txy.us-east-1.rds.amazonaws.com"
export DB_PORT="3306"
export DB_NAME="ecommerce_myshop"
export DB_USER="admin"
export DB_PASS="R00t2026*"     # ⚠️ Solo temporal si aún no usas Secrets Manager

# Para scripts RDS públicos temporales:
export DB_IDENTIFIER="microservices-fargate-mysql"

# ---------- JWT SECRET ----------
export JWT_SECRET="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."   # ⚠️ Ideal mover luego a Secrets Manager

# ---------- HEALTH ----------
export HEALTH_PATH_GATEWAY="/actuator/health"

# ---------- HTTPS ----------
export ENABLE_HTTPS="false"
export ACM_CERT_ARN=""

# ---------- Orquestador deploy_all.sh ----------
export RUN_SQL_BOOTSTRAP="false"        # true => abre RDS temporal y ejecuta SQL_FILE
export SQL_FILE="./script.sql"
export AUTO_CLOSE_DB_PUBLIC="true"      # true => revoca tu IP luego
export MAKE_PRIVATE_AFTER_SQL="false"   # true => además marca RDS como no-public

# ---------- Destroy options (si luego haces destroy.sh) ----------
export DESTROY_ECR="true"
export DESTROY_IAM="true"