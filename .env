# ============================================
# .env - Configuración para microservices-fargate
# ============================================

# ---------- AWS CONFIGURATION ----------
export REGION="us-east-1"
export PROJECT="microservices-fargate"
export ENV_NAME="prod"

# ---------- NETWORK MODE ----------
export MODE_NO_NAT="false"

# ---------- GIT CONFIGURATION ----------
export CONFIG_GIT_URI="https://github.com/Raulcudris/microservices-fargate-demo.git"
export CONFIG_GIT_BRANCH="deploy"
export CONFIG_GIT_PATHS="config-data"

# ---------- RDS DATABASE ----------
export CREATE_RDS="true"
export DB_ENDPOINT="microservices-fargate-mysql-free.cub6aqum4txy.us-east-1.rds.amazonaws.com"
export DB_PORT="3306"
export DB_NAME="ecommerce_myshop"
export DB_USER="admin"
export DB_PASS="R00t2026*"

# ---------- JWT SECRET ----------
export JWT_SECRET="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiYWRtaW4iOnRydWUsImlhdCI6MTUxNjIzOTAyMn0.KMUFsIDTnFmyG3nMiGM6H9FNFUROf3wh7SmqJp-QV30"

# ---------- HEALTH CHECKS ----------
export HEALTH_PATH_GATEWAY="/actuator/health"

# ---------- HTTPS (ALB) ----------
export ENABLE_HTTPS="false"   # true=443 + redirect 80->443, false=solo http 80
export ACM_CERT_ARN="arn:aws:acm:us-east-1:XXXX:certificate/XXXX-XXXX-XXXX"

# ---------- Autoscaling (defaults) ----------
export ASG_MIN="1"
export ASG_MAX="4"
export ASG_CPU_TARGET="60"
export ASG_MEM_TARGET="70"

# ---------- Destroy options ----------
export DESTROY_ECR="false"
export DESTROY_IAM="false"

export CREATE_RDS="true"
#export MODE_NO_NAT="true"   # recomendado para ahorrar NAT
